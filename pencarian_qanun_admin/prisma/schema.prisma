generator client {
  provider = "prisma-client-js"
  // binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Komisi {
  id          String @id @default(uuid())
  nomorKomisi Int    @map("nomor_komisi")
  nama        String @map("nama_komisi")

  Qanun Qanun[]

  @@map("komisi")
}

model Qanun {
  id       String @id @default(uuid())
  idKomisi String
  tahun    Int
  nomor    Int    @map("nomor_qanun")
  nama     String @map("nama_qanun")
  namaFile String @map("nama_file")
  views    Int    @default(0)

  komisi Komisi @relation(fields: [idKomisi], references: [id], onDelete: Cascade)

  tags Tag[]

  @@map("qanun")
}

model Tag {
  id      String @id @default(uuid())
  idQanun String
  text    String

  qanun Qanun @relation(fields: [idQanun], references: [id], onDelete: Cascade)

  @@map("tag")
}

model Users {
  id       String @id @default(uuid())
  username String
  password String

  @@map("users")
}
